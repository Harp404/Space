# AstroMesh — environment. Copy to .env and fill in.
#
# Everything degrades gracefully without credentials: the gateway falls back to
# its bundled snapshot data and the affected rules report UNRESOLVED rather
# than pretending. With credentials, the catalogue, CDMs and TIP re-entry
# predictions are fetched live.

# Space-Track (free account: https://www.space-track.org)
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# Groq (free tier: https://console.groq.com) — powers the mission-control chat
GROQ_API_KEY=

# Gateway port (default 8090)
# PORT=8090

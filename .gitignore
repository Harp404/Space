# ── Secrets / environment (NEVER commit real keys) ──
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
claude.txt

# ── Node / Vue frontend ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vite/
*.local

# ── Go backend ──
bin/
astromesh
/astromesh
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ── Local TLE snapshot (we fetch live from CelesTrak; not bundled) ──
frontend/public/tle/

# ── Server-side caches ──
# Live-fetched data (regenerates on first run against Space-Track / NOAA):
dev/cache/catalogue.3le
dev/cache/cdms.json
dev/cache/conjunctions.json
dev/cache/conjunctions.stale.bak
dev/cache/epochs.json
dev/cache/satcat-rcs.json
dev/cache/reentry-feed.json
dev/cache/starlink/
dev/cache/snapshot/
# The trained/derived artefacts (dense-consequence, exposure, sheltering,
# models/*.json) are IN the repo on purpose — they are the output of the GPU
# runs and the demo depends on them.

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Temp ──
tmp/
*.tmp

# Stray model downloads in repo root (real models live in frontend/public/models)
/*.glb
/*.gltf

# demo video (large build artifact, don't commit)
*.mp4

# ── Local research scratch (never committed) ──
research/

# ── ML training data + venv (large, downloadable; scripts print their URLs) ──
ml/data/
ml/tiles/
ml/.venv/
ml/**/__pycache__/

# ── TLA+ model checker artefacts ──
formal/states/
formal/*.out

# ── Local-only save points (tools/snapshot.sh) ──
.snapshots/

# ── ML working data (large; scripts document their sources) ──
ml/contradictions/
ml/*.log

# raw dense artefact stays local — the .gz ships (53 MB -> 2 MB, HF hard-limits plain files at 10 MB)
dev/cache/dense-consequence.json

# Captured demo frames (regenerate with demo/capture.js)
demo/frames/
demo/probe.png
demo/*.mp4
